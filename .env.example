APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true
LOG_LEVEL=debug
# Leave empty in production: React and the API are same-origin at business.com.
# For local development only, set an exact origin if a /api proxy is unavailable.
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_sync
DB_USERNAME=project_sync
DB_PASSWORD=

# Set to 1 only in a disposable database before running database integration tests.
RUN_DB_INTEGRATION_TESTS=0

SESSION_NAME=project_sync_admin
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax
SESSION_DOMAIN=
CSRF_TOKEN_TTL=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
RATE_LIMIT_SECRET=change-this-per-deployment

# Unique high-entropy secret used for protected idempotency hashes and replay-safe
# confirmation credentials. Generate independently for every merchant deployment.
ORDER_SECURITY_SECRET=change-this-to-a-long-random-secret
CHECKOUT_MAX_DISTINCT_ITEMS=50
CHECKOUT_MAX_QUANTITY=100
CHECKOUT_MAX_TOTAL_KOBO=4294967295
IDEMPOTENCY_KEY_MAX_LENGTH=200
CHECKOUT_MAX_ATTEMPTS=30
CONFIRMATION_MAX_ATTEMPTS=20
CHECKOUT_WINDOW_SECONDS=60
CHECKOUT_BLOCK_SECONDS=300

MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=orders@example.com
MAIL_FROM_NAME="Example Store"
MAIL_TIMEOUT_SECONDS=10

NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=300
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=900
NOTIFICATION_BATCH_LIMIT=50
NOTIFICATION_SECURITY_SECRET=change-this-to-an-independent-long-random-secret

# Keep this writable path outside the application source and public document root.
# Map PRODUCT_IMAGE_PUBLIC_PATH to it using cPanel/server configuration.
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_WIDTH=2000
PRODUCT_IMAGE_MAX_HEIGHT=2000
PRODUCT_IMAGE_STORAGE_PATH=storage/uploads/products
PRODUCT_IMAGE_PUBLIC_PATH=/uploads/products
