{
  "name": "project-sync/backend",
  "description": "Project Sync merchant-deployment API foundation.",
  "type": "project",
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^7.0",
    "monolog/monolog": "^3.8",
    "nikic/fast-route": "^1.3",
    "phpmailer/phpmailer": "^7.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/yaml": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "ProjectSync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "migrate": "php scripts/migrate.php",
    "preflight": "php scripts/production-preflight.php",
    "smoke-test": "php scripts/smoke-test.php",
    "openapi:generate": "php scripts/generate-openapi-json.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
